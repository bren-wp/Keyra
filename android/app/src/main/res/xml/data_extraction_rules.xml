<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The vault and its device-bound key metadata must never be silently
         copied through cloud backup or device-to-device migration. Users
         explicitly export an encrypted .keyra backup for device changes. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
